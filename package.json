{
  "name": "mikrolog",
  "description": "A minimal, structured JSON logger for Node, with optional transports and pluggable metadata providers.",
  "version": "3.0.0",
  "author": "Mikael Vesavuori",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.cjs",
      "import": "./lib/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelvesavuori/mikrolog.git"
  },
  "keywords": [
    "logger",
    "json-logger",
    "node",
    "node-logger",
    "structured-logging",
    "observability",
    "json",
    "serverless",
    "serverless-logger",
    "minimal"
  ],
  "bugs": {
    "url": "https://github.com/mikaelvesavuori/mikrolog/issues"
  },
  "homepage": "https://github.com/mikaelvesavuori/mikrolog#readme",
  "files": [
    "/lib"
  ],
  "scripts": {
    "start": "npx ts-node src/index.ts",
    "test": "npx vitest run --coverage",
    "test:watch": "npx vitest",
    "build": "npm run clean && tsup && mv dist lib",
    "clean": "rm -rf lib && rm -rf dist",
    "lint": "npx @biomejs/biome check --write ./src && npx @biomejs/biome check --write ./tests",
    "package": "npm pack",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "docs": "npm run docs:clean && npm run docs:typedoc",
    "docs:clean": "rm -rf docs",
    "docs:typedoc": "npx typedoc --entryPoints src --entryPointStrategy expand --exclude '**/*+(test).ts' --externalPattern 'node_modules/**/*' --excludeExternals --out docs/"
  },
  "optionalDependencies": {
    "aws-metadata-utils": "1"
  },
  "devDependencies": {
    "@biomejs/biome": "2",
    "@types/node": "24",
    "@vitest/coverage-v8": "4",
    "husky": "9",
    "tsup": "8",
    "typedoc": "0.28",
    "typescript": "6",
    "vitest": "4"
  }
}